# InvoiceFactoringGuard — environment variables
# Copy this to .env and fill in your values.

# Neo4j (optional locally; Compose requires a non-placeholder password)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_ENABLED=false
NEO4J_DATABASE=neo4j

# JSON array of browser origins allowed to call the API
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional server-side AI provider. Leave AI_PROVIDER=none for evidence mode.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional fallback provider if the primary provider times out or fails.
AI_FALLBACK_PROVIDER=none
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=8

# App
DEBUG=false
